@inproceedings{10.1145/3777912.3839830,
author = {Lee, Hyeonmin and Sun, Yixin},
title = {Revisit DANE for the Web: A Performance Perspective},
year = {2026},
isbn = {9798400723278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777912.3839830},
doi = {10.1145/3777912.3839830},
abstract = {DNS-based Authentication of Named Entities (DANE) offers an alternative or complementary authentication mechanism. However, DANE's web adoption is limited. In this work, we revisit DANE by focusing on a practical deployment concern for the web: added latency. Using our custom DANE-for-the-web measurement framework, we show that DANE's overhead is dominated by DNS resolution, particularly DNSSEC, which is highly sensitive to network latency and caching behavior. We further reveal that certain TLSA parameter combinations can trigger DNS-over-TCP fallback due to large response sizes, increasing DNS delay by up to 2 round trip times. Finally, our web-scale study discovers 4,435 websites supporting DANE validation for HTTPS connections, and characterizes DANE-induced delays across these real-world domains. Our findings shed light on the readiness of DANE for the web and offer guidance for efficient deployment.},
booktitle = {Proceedings of the 2026 ACM Internet Measurement Conference},
pages = {287–299},
numpages = {13},
keywords = {measurement, DNS, DNSSEC, DANE, web},
location = {Karlsruhe, Germany},
series = {IMC '26}
}

@inproceedings{10.1145/3777912.3839820,
author = {Fooda, Nehal and Larisch, James and Schanck, John and Maggs, Bruce and Chung, Tijay and Levin, Dave},
title = {A First Look at Certificate Revocation Latency},
year = {2026},
isbn = {9798400723278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777912.3839820},
doi = {10.1145/3777912.3839820},
abstract = {Certificate revocation is the last line of defense against private key compromise. When a website administrator instructs their Certificate Authority (CA) to revoke a certificate, the CA must publish that revocation data (via CRL or OCSP) in a timely manner to minimize the impact of a compromised key. While prior work has measured how quickly (and whether) websites revoke compromised certificates, whether clients check for revocation, and even the reachability of OCSP servers, there have been no studies (to our knowledge) on how quickly CAs turn revocation requests into public revocation data.In this paper, we perform the first study of the latency from a website's revocation request to when the CA makes that revocation available to clients. We develop a custom tool for revoking and downloading revocation data (both CRLs and OCSP), and apply it to six of the most popular CAs on the web today. We measure whether revocation latency varies by time of day, distribution mechanism, reason code, and other factors. We also measure the latency from when a website requests revocation to when Mozilla Firefox's CRLite revocation checking system obtains it. Collectively, we find that CAs publish revocations well within the CA/Browser (CA/B) Forum Baseline Requirements (BR). However, the window during which a revoked certificate remains functionally trusted is dominated not by CA publication speed but by cache and refresh layers the BR do not tightly constrain—pre-signed OCSP responses valid for up to seven days, and CRLs that are often 13+ hours stale at revocation time.},
booktitle = {Proceedings of the 2026 ACM Internet Measurement Conference},
pages = {300–307},
numpages = {8},
keywords = {TLS, HTTPS, certificate revocation, CRL, OCSP, certificate authority, web PKI, network measurement},
location = {Karlsruhe, Germany},
series = {IMC '26}
}

@inproceedings{10.1145/3777912.3809146,
author = {Hamza, Muhammad and Jonker, Mattijs and Sommese, Raffaele and Fernandez, Simon and Hureau, Olivier and Pauley, Eric and Chung, Tijay},
title = {Split Alignment: Diffusing SPF Vulnerabilities With DMARC},
year = {2026},
isbn = {9798400723278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777912.3809146},
doi = {10.1145/3777912.3809146},
abstract = {Email remains the backbone of online communication, yet its authentication mechanisms continue to lag behind evolving attacker capabilities. Email authentication protocols are layered, with their interactions propagating and amplifying underlying vulnerabilities. This is clearly evident in the case of SPF vulnerabilities, where pairing them with DMARC's organizational context of authentication can lead to organization-wide spoofing. In this paper, we perform a comprehensive empirical analysis of this phenomenon. Despite SPF vulnerabilities being well known, our large-scale dataset reveals 528 k vulnerable policies. When paired with DMARC, these policies enable spoofing of 79 k domain hierarchies. To mitigate this, we propose Split Alignment, a practical configurational technique that protects established email-sending domains from all SPF failures in the domain hierarchy. We then use our novel methodology to validate the security and deliverability of Split Alignment in a consistent and reproducible manner. In doing so, we identify and disclose critical bugs in the DMARC authentication flows of 4 major email services. In this way, we strengthen the security of the email ecosystem by mitigating long-standing SPF vulnerabilities.},
booktitle = {Proceedings of the 2026 ACM Internet Measurement Conference},
pages = {308–322},
numpages = {15},
keywords = {email, email security, SPF, DKIM, DMARC, internet measurement},
location = {Karlsruhe, Germany},
series = {IMC '26}
}

@inproceedings{10.1145/3777912.3839819,
author = {Hamid, Hamim and Adei, David and Reaves, Bradley},
title = {Characterizing the Deployment of the STIR/SHAKEN Telephone Network PKI},
year = {2026},
isbn = {9798400723278},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777912.3839819},
doi = {10.1145/3777912.3839819},
abstract = {In response to an epidemic of unlawful unsolicited telephone calls, the United States mandated the use of a novel, previously unimplemented call attestation framework called STIR/SHAKEN (S/S) in 2019. The mandate required telephone network operators to deploy a new, federated, industry-wide PKI in timelines shorter than 2 years for large providers. Under those circumstances, achieving any degree of successful deployment would be remarkable.In this paper, we present a longitudinal study of S/S deployment, evaluating standards compliance, certificate authority practices, and provider call signatures and metadata. Our primary data source is signaling data from 7.75 million calls collected by multiple telephone honeypots over four years (November 2021–February 2026). Our results show rapid adoption of S/S, but with pervasive non-compliance with standards.We also found repeated instances of problematic practices, including providers misreferencing the keys used to sign calls and originating calls with pre-signed attestations from unrelated calls. Despite these lapses, we find that most calls are correctly signed and that certificate authority and operator practices and standards compliance are improving at a modest pace. Our discussions highlight concrete directions to strengthen policy and deployment, enabling more effective mitigation of telephone network abuse.},
booktitle = {Proceedings of the 2026 ACM Internet Measurement Conference},
pages = {323–338},
numpages = {16},
keywords = {STIR/SHAKEN, telephone networks, public key infrastructure, call authentication, network measurement},
location = {Karlsruhe, Germany},
series = {IMC '26}
}

